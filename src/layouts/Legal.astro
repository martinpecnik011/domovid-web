---
// Plain reading layout for the legal pages (privacy, cookies): same tokens and glass tiles as the
// home page, but without the video stage so the text stays calm and readable.
import Base from './Base.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  /** Path relative to the site root, without leading slash, e.g. 'cookies/'. */
  path: string;
  /** Last update, shown under the heading (e.g. '13. 10. 2026'). */
  updated: string;
}

const { title, description, path, updated } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={`${title} – Domovid`} description={description} path={path}>
  <nav>
    <div class="wrap">
      <div class="nav-inner">
        <a class="logo" href={base}>Domov<span>id</span></a>
        <a class="back" href={base}>← Späť na úvod</a>
      </div>
    </div>
  </nav>
  <main class="wrap legal-main">
    <article class="tile legal">
      <h1>{title}</h1>
      <p class="updated">Posledná aktualizácia: {updated}</p>
      <slot />
      <p class="back-row"><a href={base}>← Späť na úvod</a></p>
    </article>
  </main>
  <Footer />
</Base>

<style>
  /* 1.17rem (18.7px, weight 750) counts as WCAG large text, so the brass "id" passes 3:1. */
  .logo { font-size: 1.17rem; }
  .back { font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 6px 12px; }
  .back:hover { color: var(--brass); }
  .legal-main { padding-block: 14px 24px; }
  .legal {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(22px, 4vw, 44px);
    gap: 14px;
    background: var(--glass-strong);
  }
  .legal h1 { font-size: clamp(1.9rem, 4vw, 2.7rem); }
  .updated { font-family: var(--f-mono); font-size: 0.74rem; color: var(--ink-muted); }
  .legal :global(h2) { font-size: clamp(1.2rem, 2.2vw, 1.45rem); margin-top: 18px; }
  .legal :global(p),
  .legal :global(li),
  .legal :global(td),
  .legal :global(th) { font-size: 0.95rem; }
  .legal :global(ul) { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .legal :global(a) { color: var(--ink); font-weight: 600; text-underline-offset: 3px; }
  .legal :global(.todo) {
    background: var(--brass-soft);
    border: 1px dashed var(--brass);
    border-radius: 8px;
    padding: 1px 6px;
    font-weight: 600;
  }
  .legal :global(.table-wrap) { overflow-x: auto; }
  .legal :global(table) { width: 100%; border-collapse: collapse; min-width: 520px; }
  .legal :global(th),
  .legal :global(td) { text-align: left; vertical-align: top; padding: 9px 10px; border-bottom: 1px solid var(--line); }
  .legal :global(th) { font-weight: 600; background: var(--brass-soft); }
  .legal :global(code) { font-family: var(--f-mono); font-size: 0.86em; }
  .back-row { margin-top: 10px; }
  .back-row a { text-decoration: none; }
</style>
