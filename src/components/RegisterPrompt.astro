---
// Sign-up prompt shown right after the page opens (once per visit, only to visitors who are not signed in).
import { DELIVERY } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<dialog class="rp" id="rp" aria-labelledby="rp-title" data-testid="register-prompt">
  <button type="button" class="rp-x" data-rp-close aria-label="Zavrieť">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <img class="rp-logo" src={base + 'media/logo.png'} alt="" width="56" height="56">
  <span class="eyebrow">Pre realitných maklérov</span>
  <h2 id="rp-title">Prvé video <em>zadarmo.</em></h2>
  <p class="muted">Zaregistrujte sa za pár sekúnd. Dopyty, fotky aj hotové videá budete mať v súkromnom chate s nami, prvá ukážka do {DELIVERY}.</p>
  <div class="rp-actions">
    <a class="btn btn-brass" href={base + 'app/?registracia=1&google=1'} data-testid="rp-google">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9z"/></svg>
      Pokračovať cez Google
    </a>
    <a class="btn btn-ghost" href={base + 'app/?registracia=1'} data-testid="rp-email">Zaregistrovať sa e-mailom</a>
  </div>
  <p class="rp-foot">Už máte účet? <a href={base + 'app/'}>Prihlásiť sa</a> · <button type="button" class="rp-later" data-rp-close>Teraz nie</button></p>
</dialog>

<script>
  // Opens shortly after load for visitors without a session; dismissed for the rest of the visit (sessionStorage).
  const KEY = 'domovid-rp-seen';
  const dlg = document.getElementById('rp') as HTMLDialogElement | null;
  const signedIn = () => {
    try {
      if (localStorage.getItem('domovid-app-mock') !== null) return true;
      for (let i = 0; i < localStorage.length; i++) if (/^sb-.*-auth-token$/.test(localStorage.key(i) ?? '')) return true;
    } catch { /* storage blocked */ }
    return false;
  };
  const seen = () => { try { return sessionStorage.getItem(KEY) !== null; } catch { return false; } };
  const markSeen = () => { try { sessionStorage.setItem(KEY, '1'); } catch { /* private mode */ } };
  if (dlg && !signedIn() && !seen()) {
    window.setTimeout(() => { if (!document.querySelector('dialog[open]')) { dlg.showModal(); markSeen(); } }, 1000);
    dlg.querySelectorAll('[data-rp-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>

<style>
  .rp {
    width: min(460px, calc(100vw - 32px)); padding: clamp(24px, 5vw, 36px); border: 1px solid var(--line-strong); border-top: 3px solid var(--gold);
    border-radius: 22px; background: var(--navy-deep); color: var(--cream); box-shadow: 0 40px 100px -30px rgba(0, 0, 0, 0.9);
  }
  .rp[open] { display: grid; gap: 14px; justify-items: start; animation: rp-in 0.3s cubic-bezier(.2,.7,.2,1); }
  .rp::backdrop { background: rgba(5, 10, 14, 0.72); backdrop-filter: blur(4px); }
  @keyframes rp-in { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
  .rp-x { position: absolute; top: 12px; right: 12px; width: 38px; height: 38px; display: grid; place-items: center; border: 0; border-radius: 50%; background: transparent; color: var(--ink-muted); cursor: pointer; }
  .rp-x:hover { background: rgba(245, 240, 232, 0.08); color: var(--cream); }
  .rp-logo { width: 56px; height: 56px; border-radius: 14px; }
  .rp h2 { font-size: clamp(2.4rem, 7vw, 3rem); }
  .rp-actions { display: grid; gap: 10px; width: 100%; margin-top: 6px; }
  .rp-actions .btn { width: 100%; }
  .rp-foot { font-size: 0.9rem; color: var(--ink-muted); }
  .rp-foot a { color: var(--gold); font-weight: 600; }
  .rp-later { padding: 0; border: 0; background: none; color: var(--ink-muted); font: inherit; text-decoration: underline; cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .rp[open] { animation: none; } }
</style>
