---
import { DISCOUNT_CODES, DISCOUNT_PERCENT } from '../config/discounts';
import { OWNER_FROM, CONTACT_EMAIL } from '../config/site';

const hasCodes = Object.keys(DISCOUNT_CODES).length > 0;
---
      <form class="tile lead-form span-3" id="lead-form" novalidate>
        <div class="field">
          <label for="name">Meno a priezvisko *</label>
          <input type="text" id="name" name="name" placeholder="napr. Peter Kováč" autocomplete="name" required aria-describedby="name-err">
          <span class="field-err" id="name-err" hidden>Napíš svoje meno.</span>
        </div>
        <div class="field">
          <label for="phone">Telefón *</label>
          <input type="tel" id="phone" name="phone" placeholder="+421 9XX XXX XXX" autocomplete="tel" required aria-describedby="phone-err">
          <span class="field-err" id="phone-err" hidden>Zadaj telefónne číslo, aspoň 9 číslic.</span>
        </div>
        <div class="field">
          <label for="email">E-mail *</label>
          <input type="email" id="email" name="email" placeholder="vas@email.sk" autocomplete="email" required aria-describedby="email-err">
          <span class="field-err" id="email-err" hidden>Zadaj platný e-mail, pošleme naň potvrdenie.</span>
        </div>
        <div class="field">
          <label for="message">Správa</label>
          <textarea id="message" name="message" rows="2" placeholder="napr. 3–5 nových ponúk mesačne, Bratislava a okolie"></textarea>
        </div>
        <fieldset class="full format">
          <legend>Formát videa</legend>
          <div class="format-opts">
            <label class="format-opt"><input type="radio" name="format" value="Na sociálne siete (9:16)" checked><span>Na sociálne siete (9:16)</span></label>
            <label class="format-opt"><input type="radio" name="format" value="Na šírku (16:9)"><span>Na šírku (16:9)</span></label>
            <label class="format-opt"><input type="radio" name="format" value="Oba formáty"><span>Oba formáty</span></label>
          </div>
        </fieldset>
        <div class="field full photos">
          <label for="photos" id="photos-label">Fotky nehnuteľnosti (voliteľné)</label>
          <div class="dropzone" id="photos-drop">
            <input type="file" id="photos" class="photos-input" multiple accept="image/*" aria-describedby="photos-hint photos-count photos-err">
            <span class="dropzone-btn" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
              Pridať fotky
            </span>
            <span class="dropzone-text" aria-hidden="true">alebo ich sem presuň</span>
          </div>
          <span class="photos-meta">
            <span id="photos-hint">Max 10 fotiek, stačia 4–6.</span>
            <span id="photos-count" class="photos-count" aria-live="polite"></span>
          </span>
          <ul class="thumbs" id="photos-list" aria-label="Vybrané fotky" hidden></ul>
          <span class="field-err" id="photos-err" role="alert" hidden></span>
        </div>
        {hasCodes && (
          <div class="field full discount">
            <button type="button" class="discount-toggle" id="discount-toggle" aria-expanded="false" aria-controls="discount-box">Mám zľavový kód</button>
            <div class="discount-box" id="discount-box" hidden>
              <label for="discount">Zľavový kód (−{DISCOUNT_PERCENT} %)</label>
              <input type="text" id="discount" name="discount" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="40" aria-describedby="discount-msg">
              <span class="discount-msg" id="discount-msg" aria-live="polite"></span>
            </div>
          </div>
        )}
        <div class="hp" aria-hidden="true">
          <label for="company">Firma</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off">
        </div>
        <div class="full" style="display:grid;gap:4px">
          <label class="consent" for="consent">
            <input type="checkbox" id="consent" name="consent" required aria-describedby="consent-err">
            <span>Súhlasím so spracovaním údajov z dopytu (vrátane fotiek), aby ma Domovid mohol kontaktovať. Podrobnosti v <a href={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'ochrana-sukromia/'} target="_blank" rel="noopener">Ochrane osobných údajov</a>.</span>
          </label>
          <span class="field-err" id="consent-err" hidden>Bez súhlasu ti nevieme odpovedať.</span>
        </div>
        <div class="full form-row">
          <button type="submit" class="btn btn-brass" id="submit-btn">Odoslať dopyt</button>
          <span class="form-note">Potvrdenie ti príde e-mailom od <strong>{OWNER_FROM}</strong> ({CONTACT_EMAIL}), hotové video ti pošleme na WhatsApp.</span>
        </div>
        <p class="full form-status" id="form-status" role="status" hidden></p>
      </form>

<script>
  import '../scripts/lead-form';
</script>

<style>
  .photos { gap: 7px; }
  .format { margin: 0; padding: 0; border: 0; min-width: 0; display: grid; gap: 5px; }
  .format legend { padding: 0; font-size: 0.82rem; font-weight: 600; }
  .format-opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .format-opt { position: relative; cursor: pointer; }
  .format-opt input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .format-opt span {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--glass-strong);
    color: var(--ink);
    font: 600 0.86rem/1 var(--f-body);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .format-opt:hover span { border-color: var(--brass); }
  .format-opt input:checked + span { border-color: var(--brass); background: var(--brass-soft); }
  .format-opt input:focus-visible + span { outline: 2px solid var(--brass); outline-offset: 2px; }
  .discount { gap: 8px; }
  .discount-toggle {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--brass);
    font: 600 0.92rem/1.4 var(--f-body);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .discount-box { display: grid; gap: 6px; }
  .discount-box[hidden] { display: none; }
  .discount-box input { text-transform: uppercase; letter-spacing: 0.04em; }
  .discount-msg { font-size: 0.88rem; min-height: 1.2em; }
  .discount-msg.ok { color: var(--whatsapp); font-weight: 600; }
  .discount-msg.error { color: var(--danger); }
  .dropzone {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 14px;
    border: 1.5px dashed var(--line);
    border-radius: 14px;
    background: var(--glass-strong);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .dropzone:hover,
  .dropzone.is-over { border-color: var(--brass); background: var(--brass-soft); }
  .dropzone:focus-within { outline: 2px solid var(--brass); outline-offset: 2px; border-color: transparent; }
  /* The real input covers the zone: click, tap (camera on phones), keyboard and native drop all hit it. */
  .photos-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    cursor: pointer;
    font-size: 0;
  }
  .photos-input:focus { outline: none; }
  .dropzone-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--brass);
    background: var(--glass-strong);
    color: var(--ink);
    font: 600 0.86rem/1 var(--f-body);
    pointer-events: none;
  }
  .dropzone-btn svg { color: var(--brass); }
  .dropzone-text { font-size: 0.84rem; color: var(--ink-muted); pointer-events: none; }
  .photos-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .photos-count { font-weight: 600; color: var(--ink); }
  .thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
    gap: 8px;
  }
  .thumbs[hidden] { display: none; }
  .thumbs :global(li) {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--glass-strong);
  }
  .thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumbs :global(.thumb-name) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 6px;
    font-size: 0.7rem;
    text-align: center;
    word-break: break-all;
    color: var(--ink-muted);
  }
  .thumbs :global(button) {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(20, 35, 48, 0.78);
    color: #fff;
    font: 600 1rem/1 var(--f-body);
    cursor: pointer;
  }
  .thumbs :global(button:hover) { background: var(--danger); }
  .thumbs :global(button:focus-visible) { outline: 2px solid var(--brass); outline-offset: 1px; }
</style>
