---
import { DELIVERY } from '../config/site';

const steps = [
  { t: 'Prihláste sa a vyplňte dotazník', d: 'Vyberiete službu, priložíte 4–6 fotiek z mobilu a napíšete, čo chcete zdôrazniť. Všetko príde rovno do vášho chatu s nami.' },
  { t: `Do ${DELIVERY} máte náhľad`, d: 'Pohyb kamery, strih, hudba a titulky. Na výšku 9:16 alebo na šírku 16:9, podľa toho, kde ho zverejníte.' },
  { t: 'Schválite a zverejníte', d: 'Úpravy riešime v chate. Prvé video na ukážku je zadarmo, potom spolupracujeme na študentskú dohodu a odmenu platíte po odovzdaní.' },
];
---
<section class="section alt" id="ako">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Ako to funguje</span>
      <h2>Tri kroky. Žiadne natáčanie.</h2>
    </div>
    <ol class="cols-line steps">
      {steps.map((s, i) => (
        <li class="reveal">
          <span class="step-no">{i + 1}</span>
          <h3>{s.t}</h3>
          <p class="muted">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; }
  .steps li { display: grid; gap: 14px; align-content: start; }
  .step-no { font-family: var(--f-display); font-stretch: 118%; font-weight: 800; font-size: 3.2rem; line-height: 1; color: var(--gold); }
</style>
