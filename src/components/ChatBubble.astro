---
// Chat button on every web page: opens the full chat in /app/ straight away (sign-in first when needed).
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="cb" id="cb">
  <a class="cb-bubble" href={base + 'app/'} aria-label="Otvoriť chat">
    <span class="cb-label" data-cb-label>Napíšte nám</span>
    <span class="cb-circle">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" transform="translate(0 -1)" /></svg>
    </span>
  </a>
</div>

<script>
  import '../scripts/chat-bubble';
</script>

<style>
  .cb {
    position: fixed; z-index: 61;
    right: max(16px, env(safe-area-inset-right));
    bottom: calc(max(36px, env(safe-area-inset-bottom) + 20px) + var(--cb-offset, 0px));
    display: flex; flex-direction: column; align-items: flex-end; gap: 12px;
    transition: bottom 0.2s ease; font-family: var(--f-body);
  }
  .cb-bubble { display: flex; align-items: center; gap: 10px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--cream); font: inherit; text-decoration: none; }
  .cb-circle {
    position: relative; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center;
    background: var(--gold); color: var(--navy); box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.7); transition: transform 0.2s ease;
  }
  .cb-bubble:hover .cb-circle { transform: scale(1.06); }
  .cb-bubble:focus-visible { outline: none; }
  .cb-bubble:focus-visible .cb-circle { outline: 3px solid var(--cream); outline-offset: 3px; }
  .cb-circle::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--gold); opacity: 0; pointer-events: none; }
  .cb-pulse .cb-circle::after { animation: cb-ring 1.4s ease-out 2; }
  @keyframes cb-ring { from { transform: scale(1); opacity: 0.8; } to { transform: scale(1.7); opacity: 0; } }
  .cb-label {
    padding: 10px 16px; border-radius: 999px; font-size: 0.92rem; font-weight: 600;
    background: var(--navy-deep); border: 1px solid var(--line-strong); box-shadow: var(--shadow);
  }
  @media (max-width: 767px) { .cb-label { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .cb, .cb-circle { transition: none; animation: none; }
    .cb-circle::after { animation: none; }
  }
</style>
