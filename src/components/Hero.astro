---
import { DELIVERY } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const media = base + 'media/';
---
<section class="hero" id="top">
  <div class="hero-media" aria-hidden="true">
    <img src={media + 'hero.jpg'} alt="" width="1920" height="1080" fetchpriority="high" decoding="async">
    <video data-hero data-src-lg={media + 'hero.mp4'} data-src-sm={media + 'hero-720.mp4'} poster={media + 'hero.jpg'} muted loop playsinline preload="none"></video>
  </div>
  <div class="wrap hero-body">
    <div class="eyebrow rise" style="--d:0">Pre realitných maklérov a realitné kancelárie</div>
    <h1>
      <span class="line"><span class="rise" style="--d:1">Videá, vizualizácie</span></span>
      <span class="line"><span class="rise" style="--d:2">a obsah na siete,</span></span>
      <span class="line"><span class="rise" style="--d:3">ktoré <em>predávajú.</em></span></span>
    </h1>
    <p class="lead rise" style="--d:4">Z fotiek vašej ponuky urobíme video, prázdny byt zariadime a postaráme sa o vaše sociálne siete. Hotové do {DELIVERY}, prvé video na ukážku zadarmo.</p>
    <div class="ctas rise" style="--d:5">
      <a class="btn btn-brass" href={base + 'app/?ponuka=1'}>Chcem ponuku</a>
      <a class="btn btn-ghost" href="#ukazky">Pozrieť ukážky</a>
    </div>
  </div>
  <a class="scroll-cue" href="#uvod" aria-label="Posunúť nižšie"><span></span></a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; margin-top: -77px; display: grid; align-items: center; overflow: hidden; isolation: isolate; }
  .hero-media { position: absolute; inset: 0; z-index: -1; }
  .hero-media img, .hero-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: drift 24s ease-out both; }
  @keyframes drift { from { transform: scale(1.12); } to { transform: scale(1); } }
  .hero-media video { opacity: 0; transition: opacity 1.4s ease; }
  .hero-media video.on { opacity: 1; }
  .hero-media::after {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(14, 25, 34, 0.9) 0%, rgba(14, 25, 34, 0.55) 48%, rgba(14, 25, 34, 0.05) 85%),
      linear-gradient(0deg, var(--bg) 0%, rgba(20, 35, 47, 0) 30%);
  }
  .hero-body { display: grid; gap: 26px; padding-top: 120px; padding-bottom: 120px; }
  .hero-body h1 { font-size: clamp(3.2rem, 7.4vw, 7.6rem); line-height: 0.98; }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .line .rise { display: inline-block; }
  .hero-body .lead { color: rgba(245, 240, 232, 0.86); }
  .rise { animation: rise 1.1s cubic-bezier(.2,.75,.2,1) both; animation-delay: calc(0.25s + var(--d) * 0.12s); }
  @keyframes rise { from { opacity: 0; transform: translateY(105%); } to { opacity: 1; transform: none; } }
  .scroll-cue { position: absolute; left: 50%; bottom: 28px; width: 26px; height: 42px; margin-left: -13px; border: 1.5px solid rgba(245, 240, 232, 0.5); border-radius: 14px; }
  .scroll-cue span { position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px; background: var(--gold); animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }
  @media (max-width: 820px) {
    .hero-media::after { background: linear-gradient(0deg, var(--bg) 8%, rgba(14, 25, 34, 0.7) 55%, rgba(14, 25, 34, 0.42) 100%); }
    .hero-body { padding-bottom: 96px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise, .hero-media img, .hero-media video, .scroll-cue span { animation: none; }
  }
</style>

<script>import '../scripts/hero-video';</script>
