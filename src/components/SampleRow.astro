---
// One service as a full-width row: copy on one side, its sample film in a phone frame that drifts on scroll.
import { grossPay } from '../config/site';

export interface Props {
  no: number;
  label: string;
  title: string;
  text: string;
  from: string;
  to: string;
  price: number;
  unit: string;
  href: string;
  video: string;
  poster: string;
  flip?: boolean;
}
const { no, label, title, text, from, to, price, unit, href, video, poster, flip = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<article class:list={['srow', { flip }]}>
  <div class="srow-copy reveal">
    <span class="srow-no">0{no}</span>
    <span class="eyebrow">{label}</span>
    <h3>{title}</h3>
    <p class="muted">{text}</p>
    <p class="srow-flow"><span>{from}</span><span class="arrow" aria-hidden="true"></span><span>{to}</span></p>
    <div class="srow-foot">
      <p class="srow-price">od <strong>{price} €</strong> <span class="muted">/ {unit} v čistom · hrubá odmena na dohode {grossPay(price)}</span></p>
      <a class="srow-link" href={base + href}>Viac o službe <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="srow-media">
    <div class="srow-glow" aria-hidden="true"></div>
    <div class="srow-phone" data-parallax="-0.08">
      <video data-src={base + video} poster={base + poster} muted loop playsinline preload="none" aria-label={`Ukážka: ${title}`}></video>
    </div>
  </div>
</article>

<style>
  .srow { overflow-x: clip; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 120px); align-items: center; padding-block: clamp(56px, 8vw, 130px); }
  .srow + :global(.srow) { border-top: 1px solid var(--line); }
  .srow.flip { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
  .srow.flip .srow-copy { order: 2; }
  .srow-copy { display: grid; gap: 20px; justify-items: start; max-width: 620px; }
  .srow-no { font-family: var(--f-display); font-weight: 500; font-style: italic; font-size: clamp(4rem, 8vw, 7rem); line-height: 0.8; color: transparent; -webkit-text-stroke: 1px var(--gold); }
  .srow-copy h3 { font-size: clamp(2.4rem, 4.2vw, 3.8rem); line-height: 1; }
  .srow-flow { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-weight: 600; }
  .srow-flow .arrow { width: 56px; height: 1px; background: var(--gold); position: relative; }
  .srow-flow .arrow::after { content: ""; position: absolute; right: 0; top: -4px; border: 4.5px solid transparent; border-left: 8px solid var(--gold); border-right: 0; }
  .srow-foot { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 32px; padding-top: 20px; border-top: 1px solid var(--line); width: 100%; }
  .srow-price strong { font-family: var(--f-display); font-weight: 600; font-size: 2.1rem; color: var(--gold); }
  .srow-price .muted { font-size: 0.92rem; }
  .srow-link { font-weight: 600; text-decoration: none; color: var(--cream); border-bottom: 1px solid var(--gold); padding-bottom: 2px; }
  .srow-link span { display: inline-block; transition: transform 0.2s ease; }
  .srow-link:hover span { transform: translateX(6px); }
  .srow-media { position: relative; justify-self: center; width: min(100%, 400px); }
  .srow-glow { position: absolute; inset: 10% -30%; border-radius: 50%; background: radial-gradient(closest-side, rgba(224, 173, 85, 0.22), transparent); filter: blur(30px); }
  .srow-phone { position: relative; padding: 9px; border-radius: 34px; background: #0b0b0b; border: 1px solid #2a2a2a; box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.9); will-change: transform; }
  .srow-phone video { width: 100%; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 26px; background: #000; }
  @media (max-width: 860px) {
    .srow, .srow.flip { grid-template-columns: minmax(0, 1fr); }
    .srow.flip .srow-copy { order: 0; }
    .srow-media { width: min(100%, 340px); justify-self: start; }
  }
</style>
