---
import type { FaqItem } from '../config/site';

export interface Props {
  items: FaqItem[];
  title?: string;
}
const { items, title } = Astro.props;
---
<div class="faq-list">
  {title && <h2 class="faq-title">{title}</h2>}
  {items.map((f) => (
    <details class="faq-item tile">
      <summary>
        <span>{f.q}</span>
        <svg class="faq-chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <p class="muted">{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-list { display: grid; }
  .faq-title { margin: 0 0 20px; }
  .faq-item summary { align-items: center; padding-inline: 0; }
  .faq-item summary:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; border-radius: 6px; }
  .faq-chev { flex: none; color: var(--gold); width: 20px; height: 20px; transition: transform 0.2s ease; }
  .faq-item[open] .faq-chev { transform: rotate(180deg); }
  .faq-item p { padding: 0; line-height: 1.65; }
  @media (prefers-reduced-motion: reduce) { .faq-chev { transition: none; } }
</style>
