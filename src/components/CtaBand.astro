---
import { DELIVERY } from '../config/site';

export interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Prvé video na ukážku je zadarmo.',
  text = `Prihláste sa, vyplňte krátky dotazník a do ${DELIVERY} máte hotovú ukážku. Platíte až keď vás presvedčí.`,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="band">
  <video class="band-bg" data-src={base + 'media/hero-720.mp4'} muted loop playsinline preload="none" aria-hidden="true"></video>
  <div class="wrap band-in reveal">
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <div class="ctas">
      <a class="btn btn-brass" href={base + 'app/?ponuka=1'}>Chcem ponuku</a>
      <a class="btn btn-ghost" href={base + 'app/'}>Napíšte nám v chate</a>
    </div>
  </div>
</section>

<style>
  .band { position: relative; overflow: hidden; isolation: isolate; border-top: 1px solid var(--line); background: var(--bg-alt); }
  .band-bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }
  .band::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--bg-alt) 10%, rgba(14, 25, 34, 0.55) 70%, rgba(14, 25, 34, 0.35)); }
  .band-in { display: grid; gap: 24px; justify-items: start; padding-block: clamp(80px, 11vw, 170px); }
  .band-in h2 { font-size: clamp(2.8rem, 6.4vw, 6.2rem); max-width: 16ch; }
</style>

<script>import '../scripts/inview-video';</script>
