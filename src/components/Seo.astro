---
import {
  SITE_URL,
  OG_TITLE,
  SITE_NAME,
  SITE_DESCRIPTION,
  INSTAGRAM_URL,
  FACEBOOK_URL,
  YOUTUBE_URL,
  TIKTOK_URL,
  LOGO_PATH,
  SERVICE_TYPE,
  AREA_SERVED,
  CONTACT_EMAIL,
  PRICES,
  SERVICES,
  type FaqItem,
} from '../config/site';

export interface Props {
  title: string;
  description: string;
  /** Path relative to the site root, without leading slash ('' = home). */
  path?: string;
  ogTitle?: string;
  /** Image path relative to the site root. */
  image?: string;
  /** true = keep the page out of search indexes (links are still followed). */
  noindex?: boolean;
  /** With noindex: also tell crawlers not to follow links ('noindex, nofollow'). */
  nofollow?: boolean;
  /** Open Graph type of the page. */
  type?: 'website' | 'article';
  /** schema.org type of the WebPage node, e.g. 'AboutPage', 'ContactPage'. */
  pageType?: string;
  /** Browser UI colour (meta theme-color) for this page. */
  themeColor?: string;
  /** Visible FAQ of the page; FAQPage JSON-LD is emitted only when given (markup must match what is on the page). */
  faq?: FaqItem[];
}

const {
  title,
  description,
  path = '',
  ogTitle = OG_TITLE,
  image = 'media/og.jpg',
  noindex = false,
  nofollow = false,
  type = 'website',
  pageType = 'WebPage',
  themeColor = '#f3f7fa',
  faq,
} = Astro.props;
const url = SITE_URL + path;
const showOffers = path === '' || path === 'cennik/';
const robots = noindex
  ? nofollow
    ? 'noindex, nofollow'
    : 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Every absolute URL derives from SITE_URL, so a custom domain is a one-line change in site.ts.
const id = (frag: string) => SITE_URL + '#' + frag;
const ogImage = SITE_URL + image;
const organization = {
  '@type': 'Organization',
  '@id': id('organization'),
  name: SITE_NAME,
  url: SITE_URL,
  logo: { '@type': 'ImageObject', url: SITE_URL + LOGO_PATH, width: 512, height: 512 },
  image: ogImage,
  sameAs: [INSTAGRAM_URL, FACEBOOK_URL, YOUTUBE_URL, TIKTOK_URL],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: CONTACT_EMAIL,
    areaServed: AREA_SERVED,
    availableLanguage: ['sk'],
  },
};
const website = {
  '@type': 'WebSite',
  '@id': id('website'),
  url: SITE_URL,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  inLanguage: 'sk',
  publisher: { '@id': id('organization') },
};
const webpage = {
  '@type': pageType,
  '@id': url + '#webpage',
  url,
  name: title,
  description,
  inLanguage: 'sk',
  isPartOf: { '@id': id('website') },
  about: { '@id': id('organization') },
};
const offerOf = (
  serviceId: string,
  name: string,
  description: string,
  price: number,
  unitText: string,
) => {
  const svc = SERVICES.find((x) => x.id === serviceId)!;
  return {
    '@type': 'Offer',
    name,
    description,
    url: SITE_URL + svc.href,
    price,
    priceCurrency: 'EUR',
    valueAddedTaxIncluded: false,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price,
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: false,
      unitText,
    },
    itemOffered: {
      '@type': 'Service',
      name: svc.label,
      serviceType: svc.claim,
      provider: { '@id': id('organization') },
      areaServed: AREA_SERVED,
    },
  };
};
const offers = [
  offerOf('video', 'Videá nehnuteľností: 1 video', 'Video z fotiek vašej ponuky do 24 hodín.', PRICES.video.single, 'video'),
  offerOf('video', 'Videá nehnuteľností: mesačný balík', `${PRICES.video.monthlyCount} videá mesačne.`, PRICES.video.monthly, 'mesiac'),
  offerOf('viz', 'Vizualizácie: 1 video', `Najviac ${PRICES.viz.maxViz} vizualizácií na nehnuteľnosť.`, PRICES.viz.single, 'video'),
  offerOf('viz', 'Vizualizácie: mesačný balík', `${PRICES.viz.monthlyCount} nehnuteľnosti mesačne.`, PRICES.viz.monthly, 'mesiac'),
  ...PRICES.social.plans.map((p) =>
    offerOf('social', `Sociálne siete: ${p.videos} videí mesačne`, `Viazanosť ${PRICES.social.commitmentMonths} mesiace.`, p.price, 'mesiac'),
  ),
];
const service = {
  '@type': 'ProfessionalService',
  '@id': id('service'),
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  image: ogImage,
  email: CONTACT_EMAIL,
  serviceType: SERVICE_TYPE,
  areaServed: AREA_SERVED.map((c) => ({ '@type': 'Country', name: c })),
  parentOrganization: { '@id': id('organization') },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Cenník',
    itemListElement: offers,
  },
};
// FAQPage only when the page passes its visible FAQ: the markup must match questions shown on the same page.
const faqPage = {
  '@type': 'FAQPage',
  '@id': url + '#faq',
  url: url + '#faq',
  inLanguage: 'sk',
  isPartOf: { '@id': id('website') },
  mainEntity: (faq ?? []).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const graph = [organization, website, webpage, ...(showOffers ? [service] : []), ...(faq?.length ? [faqPage] : [])];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<meta property="og:type" content={type}>
<meta property="og:locale" content="sk_SK">
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="720">
<meta name="twitter:card" content="summary_large_image">
<!-- Deliberate: the browser bar on web pages stays light (#f3f7fa, matching the light page header);
     public/manifest.webmanifest uses navy #14232F for the installed PWA (splash/standalone title bar).
     Pages may override via the themeColor prop. -->
<meta name="theme-color" content={themeColor}>
<!-- Favicon = the Domovid logo as real files: Google Search shows it only from a crawlable square icon, a multiple of 48 px. -->
<link rel="icon" href={import.meta.env.BASE_URL + 'favicon.ico'} sizes="48x48">
<link rel="icon" type="image/png" href={import.meta.env.BASE_URL + 'favicon-96.png'} sizes="96x96">
<link rel="canonical" href={url}>
<link rel="sitemap" href={SITE_URL + 'sitemap-index.xml'}>
<script type="application/ld+json" is:inline set:html={jsonLd} />
