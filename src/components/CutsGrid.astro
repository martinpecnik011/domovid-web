---
export interface Props {
  items: { id: string; title: string; desc: string; video: string; poster: string; cats?: string[] }[];
  modal?: boolean;
}
const { items, modal = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const url = (p: string) => base + p.replace(/^\//, '');
---
<div class="cuts-grid" role="region" aria-label="Galéria ukážok" tabindex="0">
  {items.map((c) => (
    <article class="cut" data-cats={(c.cats ?? []).join(' ')} data-id={c.id}>
      <div class="cut-poster">
        <img src={url(c.poster)} alt="" width="480" height="854" loading="lazy" decoding="async">
        <span class="cut-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" fill="currentColor"/></svg></span>
      </div>
      <div class="cut-info">
        <span class="cut-name">{c.title}</span>
        <span class="cut-desc">{c.desc}</span>
      </div>
      <button type="button" class="gcard-open" aria-label={`Prehrať ukážku ${c.title}`} data-video={new URL(url(c.video), Astro.site ?? 'http://localhost').href}></button>
    </article>
  ))}
</div>

{modal && (
  <dialog class="vmodal" aria-label="Ukážka videa">
    <button type="button" class="vmodal-close">Zavrieť</button>
    <video controls autoplay muted loop playsinline></video>
  </dialog>
)}
{modal && <script>import '../scripts/showcase-modal';</script>}

<style>
  .gcard-open {
    position: absolute; inset: 0; z-index: 3;
    margin: 0; padding: 0; border: 0; border-radius: inherit;
    background: transparent; cursor: pointer;
  }
  .cut:has(.gcard-open:focus-visible) { outline: 3px solid var(--brass); outline-offset: 3px; }
  .gcard-open:focus-visible { outline: none; }

  .vmodal {
    margin: auto; padding: 0; border: 0; background: #000; color: #fff;
    border-radius: 16px; overflow: hidden; max-width: 92vw; max-height: 90dvh;
  }
  .vmodal::backdrop { background: rgba(8, 14, 20, 0.78); }
  .vmodal video { display: block; height: min(90dvh, 900px); max-width: 92vw; width: auto; aspect-ratio: 9 / 16; background: #000; }
  .vmodal-close {
    position: absolute; top: 10px; right: 10px; z-index: 2;
    font: inherit; font-size: 0.9rem; padding: 8px 14px; border: 0; border-radius: 999px;
    background: var(--gold); color: var(--navy); cursor: pointer;
  }
  .vmodal-close:focus-visible { outline: 3px solid var(--brass); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    .vmodal[open] { animation: vmodal-in 0.22s ease-out; }
    @keyframes vmodal-in { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: none; } }
  }

  .cuts-grid { display: grid; gap: clamp(16px, 2vw, 28px); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cut { position: relative; display: grid; gap: 12px; align-content: start; min-width: 0; }
  .cut[hidden] { display: none; }
  .cut-poster { position: relative; aspect-ratio: 9 / 16; border-radius: 16px; overflow: hidden; background: #111; }
  .cut-poster img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .cut-play {
    position: absolute; left: 50%; top: 50%; width: 68px; height: 68px; margin: -34px 0 0 -34px;
    display: grid; place-items: center; border-radius: 50%; color: var(--navy); padding-left: 3px; box-sizing: border-box;
    background: var(--gold); pointer-events: none; transition: transform 0.25s ease;
  }
  .cut-info { display: grid; gap: 4px; }
  .cut-name { font-weight: 700; font-size: 1.05rem; }
  .cut-desc { font-size: 0.9rem; line-height: 1.45; color: var(--ink-muted); }
  @media (hover: hover) {
    .cut:hover .cut-poster img { transform: scale(1.04); }
    .cut:hover .cut-play { transform: scale(1.1); }
  }
  @media (max-width: 1100px) { .cuts-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .cuts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
